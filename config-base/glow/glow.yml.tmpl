# glow configuration
# style name or JSON path (default "auto")
style: "{{env "HOME"}}/.config/glow/style.json"
# mouse support (TUI-mode only)
mouse: false
# use pager to display markdown
pager: false
# word-wrap at width
width: {{.vars.default_terminal_width}}
# show all files, including hidden and ignored.
all: false
