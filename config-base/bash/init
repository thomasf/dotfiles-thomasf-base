# -*- mode: sh -*-
source ~/.config-base/bash/common

# ------------------------------------------------------------------------------
# HOME DIR LOCAL ENVIRONMENTS
#
bash_start_time=${EPOCHSECONDS:-$(date +%s)}
bash_uptime() {
  echo "$(( ${EPOCHSECONDS:-$(date +%s)} - bash_start_time )) seconds"
}

# log is supposed to help shell init performance debugging.
log() {
  # [ ! -z "$PS1" ] \
  #   && [ ! "${TERM}" == "dumb" ] \
  #   && [ ! "${TERM}" == "eterm" ] \
  #   && [ ! "${TERM}" == "eterm-color" ] \
  #   && echo "$(date +%s.%N) ■ ${1}"
  #   && echo -n "■"
  return 0
}
export -f log


# -------------------------------------------------------------------------------
# gpg-agent passphrase prompts
#
log "gpg-agent"
if [ -n "$SSH_CLIENT" ]; then
  # pinentry-auto asks in this terminal instead of on the desktop.
  PINENTRY_USER_DATA=tty
  export PINENTRY_USER_DATA
fi
if [ -t 0 ]; then
  GPG_TTY=$(tty)
  export GPG_TTY
fi


# ------------------------------------------------------------------------------
# super minimal virtualenvwrapper replacement
#
# Defined for non-interactive shells too, since pathenv entries use it and
# pathenv exec sources only the non-interactive part.

workon() {
  local name="${1}"
  if [ -z "${name}" ]; then
    name=$(lsvirtualenvs | fzf)
  fi

  local activate="${HOME}/.virtualenvs/${name}/bin/activate"
  if [ -f "${activate}" ]; then
    source "${activate}"
  else
    echo "script not found: ${activate}"
    return 1
  fi
}


# ------------------------------------------------------------------------------
# pathenv: see dotfiles pathenv -h.

pathenv() {
  case ${1-} in
    status | exec | -n | -h | help) dotfiles pathenv -shell bash "$@" ;;
    *) local code
       code=$(dotfiles pathenv -shell bash "$@") && eval "$code" ;;
  esac
}


# ------------------------------------------------------------------------------
# NON INTERACTIVE RETURN POINT
#
[ -z "$PS1" ] \
  && return

# ------------------------------------------------------------------------------
# LOAD INTERACTIVE
#

source ~/.config-base/bash/interactive

#
#
#
# .....  and here followed all old stuff
#


# ------------------------------------------------------------------------------
# PRIVATE AND LOCAL
#
[ -e "${HOME}/.bashrc-private" ] \
  && source "${HOME}/.bashrc-private" \
  && log "loaded .bashrc-private"

[ -e "${HOME}/.bashrc-local" ] \
  && source "${HOME}/.bashrc-local" \
  && log "loaded .bashrc-local"

# The colors of the theme in use on the console, written by dotfiles
if [ "$TERM" = "linux" ]; then
  [ -e "${HOME}/.config/theme/console.sh" ] \
    && source "${HOME}/.config/theme/console.sh"
  clear
  (
    [ -e /tmp/.X11-unix ] &&
      cd /tmp/.X11-unix
    for x in X*; do
      echo "found local x11 session: :${x#X}";
    done
  )
fi

# ------------------------------------------------------------------------------
# BASH
#
log "bash config"
shopt -s checkwinsize

if [ ! ${__OS} = darwin ]; then
  shopt -s checkjobs
  shopt -s cdspell
  shopt -s dirspell
fi
export HISTFILE="${HOME}/.bash_history.${UID}"
shopt -s histappend
export HISTCONTROL=ignoredups
export HISTSIZE=50000
export HISTTIMEFORMAT='%F %T '
export HISTIGNORE="   *:ls:cd*:[bf]g:exit:pwd:clear:reset:history*:sudo reboot*:sudo shutdown*?"

#
# ------------------------------------------------------------------------------
#
#   emacs ansiterm
#
if [ "$TERM" = "eterm-color" ]; then
  function __eterm_set_cwd {
    echo -e "\033AnSiTc" "$(pwd)"
  }
  function eterm-reset() {
    echo -e "\033AnSiTu" "$LOGNAME"
    __eterm_set_cwd
    if [ $(uname) = "SunOS" ]; then
      hostname_options="";
    else
      hostname_options="-f";
    fi
    echo -e "\033AnSiTh" "$(hostname $hostname_options)"
  }
  eterm-reset
fi

# Add faked cd with full paths to log whenever pwd changes
export __last_logged_pwd=${PWD// /\\ }
__pwd_logger() {
  local CPWD=${PWD// /\\ }
  if [[ ! "$CPWD" == "$__last_logged_pwd" ]]; then
    local HISTIGNORE=""
    history -s cd ${CPWD}
    __last_logged_pwd=${CPWD}
    declare -f __eterm_set_cwd >/dev/null && __eterm_set_cwd
  fi
}
export -f __pwd_logger

# ------------------------------------------------------------------------------
#
# TERMINAL OPTIONS
#
# enable xon/xoff flow control
hash stty 2>/dev/null &&
  stty -ixon

# ------------------------------------------------------------------------------
# COMPLETION
#

log "bash completion"
if ! declare -F _filedir >/dev/null 2>&1 && ! shopt -oq posix; then
  if [ -f "/etc/bash_completion" ]; then
    source "/etc/bash_completion"
  elif [ -f "/usr/share/bash-completion/bash_completion" ]; then
    source "/usr/share/bash-completion/bash_completion"
  elif [ -f "/usr/local/etc/bash_completion" ]; then
    source "/usr/local/etc/bash_completion"
  elif [ -f "/opt/homebrew/etc/bash_completion" ]; then
    source "/opt/homebrew/etc/bash_completion"
  fi
fi

if declare -F _filedir >/dev/null 2>&1 || [ -n "${BASH_COMPLETION_VERSINFO-}" ]; then
  _lazy_load_completion() {
    local file="${1}"; shift
    local comp_func="${1}"; shift
    for cmd in "${@}"; do
      eval "_lazy_complete_${cmd}() {
        complete -r ${cmd} 2>/dev/null
        source \"${file}\"
        if declare -F \"${comp_func}\" >/dev/null 2>&1; then
          \"${comp_func}\" \"\$@\"
        fi
      }"
      complete -o default -F "_lazy_complete_${cmd}" "${cmd}"
    done
  }

  for file in "${HOME}/.config-base/bash/completion.d/"*; do
    [ -f "${file}" ] || continue
    case "${file}" in
      */kubectl|*/docker) continue ;;
    esac
    source "${file}"
  done

  _lazy_load_completion "${HOME}/.config-base/bash/completion.d/kubectl" __start_kubectl kubectl k
  _lazy_load_completion "${HOME}/.config-base/bash/completion.d/docker" _docker docker docker.exe dockerd dockerd.exe

  # fzf must load after bash-completion
  if hash fzf 2>/dev/null; then
    eval "$(fzf --bash)"
    _fzf_setup_completion path o e ee g rg eza
    _fzf_setup_completion dir tree bakdir dust fd tokei scc
    _fzf_setup_completion proc gops
    _fzf_setup_completion host ssh-copy-id
  fi
fi

alias t=todo.sh

# ------------------------------------------------------------------------------
# DIRCOLORS
#
log "dircolors"
if [ -z "$LS_COLORS" ] && [ -x /usr/bin/dircolors ]; then
  test -r ~/.config-base/dircolors/default && eval "$(dircolors -b ~/.config-base/dircolors/default 2>/dev/null)" || eval "$(dircolors -b)"
  alias grep='grep --color=auto'
  alias fgrep='fgrep --color=auto'
  alias egrep='egrep --color=auto'
fi

export LSCOLORS=gxfxbEaEBxxEhEhBaDaCaD

cdsitepackages() {
  cd $(python3 -c "import sysconfig; print(sysconfig.get_path('platlib'))")
}

python-lsp-ensure() {
  # pip uninstall -y flake8 python-lsp-ruff
  pip uninstall -y flake8 python-lsp-ruff python-lsp-server
  # pip install --upgrade \
  #     python-lsp-server[rope] \
  #     pylsp-rope \
  #     pdbpp \
  #     funcsigs
  pip install --upgrade \
      basedpyright \
      pdbpp \
      funcsigs
}

mkvirtualenv() {
  deactivate || true
  mkdir -p "${HOME}/.virtualenvs"
  local dir
  dir="${HOME}/.virtualenvs/${1}"
  shift || return 1
  python3 -mvenv "${dir}" "${@}" || return 1
  source "${dir}/bin/activate" || return 1
  pip install --upgrade wheel setuptools pip
  python-lsp-ensure
}

lsvirtualenvs() {
  find ~/.virtualenvs -maxdepth 1 -mindepth 1 -type d -printf '%P\n'
}

# ------------------------------------------------------------------------------
# Misc
#

_z() {
  case "$1" in
    -l)
      zzz "$@"
      ;;
    *)
      local dir
      dir=$(zzz "$@")
      if [ -d "$dir" ]; then
        cd "$dir"
      else
        echo "No match found"
      fi
      ;;
  esac
}

if [ -x /usr/bin/lesspipe ]; then
  export LESSCLOSE="/usr/bin/lesspipe %s %s"
  if [ -f /usr/share/source-highlight/src-hilite-lesspipe.sh ]; then
    export LESSOPEN="| /usr/share/source-highlight/src-hilite-lesspipe.sh %s"
    export LESS=' -R '
  else
    export LESSOPEN="| /usr/bin/lesspipe %s"
  fi
fi

[ -f "${__SHBASE}/functions" ] \
  && log "functions" \
  && source "${__SHBASE}/functions"


# clipboard paste
if [ -n "$DISPLAY" ] && [ -x /usr/bin/xsel ] ; then
  # Work around a bash bug: \C-@ does not work in a key binding
  bind '"\C-x\C-m": set-mark'
  # The '#' characters ensure that kill commands have text to work on; if
  # not, this binding would malfunction at the start or end of a line.
  bind 'Control-v: "#\C-b\C-k#\C-x\C-?\"$(xsel -ob --clipboard)\"\e\C-e\C-x\C-m\C-a\C-y\C-?\C-e\C-y\ey\C-x\C-x\C-d"'
fi


# Activate the prompt
log "activate prompt"

case $TERM in
  dumb)
    # do nothing
    ;;
  *)
    if hash shell-prompt 2>/dev/null; then
      log "prompt"
      eval "$(shell-prompt init -pathenv bash)"
    fi
    ;;
esac

log "set manpath"
if [ -z "${MANPATH}" ] && hash manpath 2>/dev/null; then
  export MANPATH=$(manpath -q)
fi

case $TERM in
  dumb)
  # do nothing
  ;;
  *)
    echo -e -n '\r'
    ;;
esac

log "cd to workspace"
if [ ! "${TERM}" == "dumb" ] && [ "${PWD}" == "${HOME}" ]; then
  if wsdir-cd >/dev/null || cdd >/dev/null; then
    git status --short --branch 2>/dev/null || true
  fi
  history -n
  __pwd_logger
fi

# The only time pathenv runs untyped: once per shell, in whatever directory
# it starts in. Not over SSH, with PATHENV_SKIP set, or without dotfiles.
log "pathenv"
[ ! "${TERM}" == "dumb" ] && [ -z "${PATHENV_SKIP}${SSH_CONNECTION}" ] &&
  hash dotfiles 2>/dev/null && { pathenv -q >/dev/null || true; }

log "maybe list tmux sessions"
[ ! -z $SSH_TTY ] &&
  [ -z $TMUX ] &&
  hash tmux 2>/dev/null &&
  tmux list-sessions 2>/dev/null ||
    true

[ $UID == 0 ] &&
  export TMOUT=3600 ||
    true

log "init done"

# replace log function with empty stub
log() {
  return 0
}

# end of init
