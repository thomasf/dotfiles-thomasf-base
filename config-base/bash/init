# -*- mode: sh -*-
source ~/.config-base/bash/common

# ------------------------------------------------------------------------------
# HOME DIR LOCAL ENVIRONMENTS
#
bash_start_time=$(date +%s)
bash_uptime() {
  echo "$(($(date +%s)-${bash_start_time})) seconds"
}

# log is supposed to help shell init performance debugging.
log() {
  # [ ! -z "$PS1" ] \
  #   && [ ! "${TERM}" == "dumb" ] \
  #   && [ ! "${TERM}" == "eterm" ] \
  #   && [ ! "${TERM}" == "eterm-color" ] \
  #   && echo "$(date +%s.%N) ■ ${1}"
  #   && echo -n "■"
  return 0
}
export -f log


# -------------------------------------------------------------------------------
# gpg-agent passphrase prompts
#
log "gpg-agent"
if [ -n "$SSH_CLIENT" ]; then
  # pinentry-auto asks in this terminal instead of on the desktop.
  PINENTRY_USER_DATA=tty
  export PINENTRY_USER_DATA
fi
if [ -t 0 ]; then
  GPG_TTY=$(tty)
  export GPG_TTY
fi


# ------------------------------------------------------------------------------
# super minimal virtualenvwrapper replacement
#
# Defined for non-interactive shells too, since workspace environments
# (ws env) use it and bin/emacs sources those.

workon() {
  local name="${1}"
  if [ -z "${name}" ]; then
    name=$(lsvirtualenvs | fzf)
  fi

  local activate="${HOME}/.virtualenvs/${name}/bin/activate"
  if [ -f "${activate}" ]; then
    source "${activate}"
  else
    echo "script not found: ${activate}"
    return 1
  fi
}


# ------------------------------------------------------------------------------
# NON INTERACTIVE RETURN POINT
#
[ -z "$PS1" ] \
  && return

# ------------------------------------------------------------------------------
# LOAD INTERACTIVE
#

source ~/.config-base/bash/interactive

#
#
#
# .....  and here followed all old stuff
#


# ------------------------------------------------------------------------------
# PRIVATE AND LOCAL
#
[ -e "${HOME}/.bashrc-private" ] \
  && . "${HOME}/.bashrc-private" \
  && log "loaded .bashrc-private"

[ -e "${HOME}/.bashrc-local" ] \
  && . "${HOME}/.bashrc-local" \
  && log "loaded .bashrc-local"

# The colors of the theme in use on the console, written by dotfiles
if [ "$TERM" = "linux" ]; then
  [ -e "${HOME}/.config/theme/console.sh" ] \
    && . "${HOME}/.config/theme/console.sh"
  clear
  (
    [ -e /tmp/.X11-unix ] &&
      cd /tmp/.X11-unix
    for x in X*; do
      echo "found local x11 session: :${x#X}";
    done
  )
fi

# ------------------------------------------------------------------------------
# BASH
#
log "bash config"
shopt -s checkwinsize

if [ ! ${__OS} = darwin ]; then
  shopt -s checkjobs
  shopt -s cdspell
  shopt -s dirspell
fi
export HISTFILE="${HOME}/.bash_history.${UID}"
shopt -s histappend
export HISTCONTROL=ignoredups
export HISTSIZE=50000
export HISTTIMEFORMAT='%F %T '
export HISTIGNORE="   *:ls:cd*:[bf]g:exit:pwd:clear:reset:history*:sudo reboot*:sudo shutdown*?"

#
# ------------------------------------------------------------------------------
#
#   emacs ansiterm
#
if [ "$TERM" = "eterm-color" ]; then
  function __eterm_set_cwd {
    echo -e "\033AnSiTc" "$(pwd)"
  }
  function eterm-reset() {
    echo -e "\033AnSiTu" "$LOGNAME"
    __eterm_set_cwd
    if [ $(uname) = "SunOS" ]; then
      hostname_options="";
    else
      hostname_options="-f";
    fi
    echo -e "\033AnSiTh" "$(hostname $hostname_options)"
  }
  eterm-reset
fi

# Add faked cd with full paths to log whenever pwd changes
export __last_logged_pwd=${PWD// /\\ }
__pwd_logger() {
  local CPWD=${PWD// /\\ }
  if [[ ! "$CPWD" == "$__last_logged_pwd" ]]; then
    local HISTIGNORE=""
    history -s cd ${CPWD}
    __last_logged_pwd=${CPWD}
    declare -f __eterm_set_cwd >/dev/null && __eterm_set_cwd
  fi
}
export -f __pwd_logger

# ------------------------------------------------------------------------------
#
# TERMINAL OPTIONS
#
# enable xon/xoff flow control
hash stty 2>/dev/null &&
  stty -ixon

# ------------------------------------------------------------------------------
# COMPLETION
#

log "bash completion"
[ -f "/etc/bash_completion" ] \
  && ! shopt -oq posix \
  && . "/etc/bash_completion"

[ -f "/usr/local/etc/bash_completion" ] \
  && ! shopt -oq posix \
  && . "/usr/local/etc/bash_completion"

[ -f "/opt/homebrew/etc/bash_completion" ] \
  && ! shopt -oq posix \
  && . "/opt/homebrew/etc/bash_completion"

for file in $(find $HOME/.config-base/bash/completion.d/ -mindepth 1 -maxdepth 1 -not -type d  ); do
  source $file
done

alias t=todo.sh

# ------------------------------------------------------------------------------
# DIRCOLORS
#
log "dircolors"
if [ -x /usr/bin/dircolors ]; then
  test -r ~/.config-base/dircolors/default && eval "$(dircolors -b ~/.config-base/dircolors/default 2>/dev/null)" || eval "$(dircolors -b)"
  alias grep='grep --color=auto'
  alias fgrep='fgrep --color=auto'
  alias egrep='egrep --color=auto'
fi

export LSCOLORS=gxfxbEaEBxxEhEhBaDaCaD

cdsitepackages() {
  cd $(python3 -c "import sysconfig; print(sysconfig.get_path('platlib'))")
}

python-lsp-ensure() {
  # pip uninstall -y flake8 python-lsp-ruff
  pip uninstall -y flake8 python-lsp-ruff python-lsp-server
  # pip install --upgrade \
  #     python-lsp-server[rope] \
  #     pylsp-rope \
  #     pdbpp \
  #     funcsigs
  pip install --upgrade \
      basedpyright \
      pdbpp \
      funcsigs
}

mkvirtualenv() {
  deactivate || true
  mkdir -p "${HOME}/.virtualenvs"
  local dir
  dir="${HOME}/.virtualenvs/${1}"
  shift || return 1
  python3 -mvenv "${dir}" "${@}" || return 1
  . "${dir}/bin/activate" || return 1
  pip install --upgrade wheel setuptools pip
  python-lsp-ensure
}

lsvirtualenvs() {
  find ~/.virtualenvs -maxdepth 1 -mindepth 1 -type d -printf '%P\n'
}

# ------------------------------------------------------------------------------
# Misc
#

_z() {
  case "$1" in
    -l)
      zzz "$@"
      ;;
    *)
      local dir
      dir=$(zzz "$@")
      if [ -d "$dir" ]; then
        cd "$dir"
      else
        echo "No match found"
      fi
      ;;
  esac
}

if [ -x /usr/bin/lesspipe ]; then
  eval "$(SHELL=/bin/sh lesspipe)"
  if [ -f /usr/share/source-highlight/src-hilite-lesspipe.sh ]; then
    export LESSOPEN="| /usr/share/source-highlight/src-hilite-lesspipe.sh %s"
    export LESS=' -R '
  fi
fi

[ -f "${__SHBASE}/functions" ] \
  && log "functions" \
  && . "${__SHBASE}/functions"


# clipboard paste
if [ -n "$DISPLAY" ] && [ -x /usr/bin/xsel ] ; then
  # Work around a bash bug: \C-@ does not work in a key binding
  bind '"\C-x\C-m": set-mark'
  # The '#' characters ensure that kill commands have text to work on; if
  # not, this binding would malfunction at the start or end of a line.
  bind 'Control-v: "#\C-b\C-k#\C-x\C-?\"$(xsel -ob --clipboard)\"\e\C-e\C-x\C-m\C-a\C-y\C-?\C-e\C-y\ey\C-x\C-x\C-d"'
fi


# Activate the prompt
log "activate prompt"

case $TERM in
  dumb)
    # do nothing
    ;;
  *)
    if hash shell-prompt 2>/dev/null; then
      log "prompt"
      eval "$(shell-prompt init bash)"
    fi
    ;;
esac

# Activate mise after the prompt since shell-prompt overwrites PROMPT_COMMAND
log "mise"
if hash mise 2>/dev/null; then
  eval "$(mise activate bash)"
fi


log "set manpath"
hash manpath 2>/dev/null &&
  unset MANPATH &&
  export MANPATH=$(manpath -q)

case $TERM in
  dumb)
  # do nothing
  ;;
  *)
    echo -e -n '\r'
    ;;
esac

log "source wsenv"
if [ ! "${TERM}" == "dumb" ] &&
     [ "${PWD}" == "${HOME}" ]; then
  if wsdir-cd >/dev/null || cdd  >/dev/null ; then
    [ -z "${WSENV_SKIP}" ] && { wsenv-source >/dev/null || true; }
    # [ -z $VIRTUAL_ENV ] &&
    #   hash wsname 2>/dev/null &&
    #   [ $(wsname -p >/dev/null ) ] &&
    #   workon $(wsname -p) 2>/dev/null || true
    git status --short --branch 2>/dev/null || true
  fi
  history -n
  __pwd_logger
fi

log "maybe list tmux sessions"
[ ! -z $SSH_TTY ] &&
  [ -z $TMUX ] &&
  hash tmux 2>/dev/null &&
  tmux list-sessions 2>/dev/null ||
    true

[ $UID == 0 ] &&
  export TMOUT=3600 ||
    true

log "init done"

# replace log function with empty stub
log() {
  return 0
}

# end of init
