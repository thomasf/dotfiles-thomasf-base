# eza theme configuration, generated by dotfiles theme from
# {{.theme.name}}:{{.theme.variant}} ({{.theme.mode}} mode).
#
# Sets permissions, punctuation and date to the muted comment tone (dim_0)
# without bold/underline styles to remove visual noise from the long view.
colourful: true

perms:
  user_read: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false }
  user_write: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false }
  user_execute_file: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false, is_underline: false }
  user_execute_other: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false, is_underline: false }

  group_read: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false }
  group_write: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false }
  group_execute: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false, is_underline: false }

  other_read: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false }
  other_write: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false }
  other_execute: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false, is_underline: false }

  special_user_file: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false }
  special_other: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false }
  attribute: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false }

punctuation: { foreground: "{{ .theme.colors.dim_0 }}", is_bold: false }
date: { foreground: "{{ .theme.colors.dim_0 }}" }

# File sizes: cool palette (green -> cyan -> blue -> magenta) avoiding red and yellow.
size:
  number_byte: { foreground: "{{ .theme.colors.green }}", is_bold: false }
  number_kilo: { foreground: "{{ .theme.colors.green }}", is_bold: false }
  number_mega: { foreground: "{{ .theme.colors.cyan }}", is_bold: false }
  number_giga: { foreground: "{{ .theme.colors.blue }}", is_bold: false }
  number_huge: { foreground: "{{ .theme.colors.magenta }}", is_bold: false }

  unit_byte: { foreground: "{{ .theme.colors.green }}", is_bold: false }
  unit_kilo: { foreground: "{{ .theme.colors.green }}", is_bold: false }
  unit_mega: { foreground: "{{ .theme.colors.cyan }}", is_bold: false }
  unit_giga: { foreground: "{{ .theme.colors.blue }}", is_bold: false }
  unit_huge: { foreground: "{{ .theme.colors.magenta }}", is_bold: false }

  major: { foreground: "{{ .theme.colors.cyan }}", is_bold: false }
  minor: { foreground: "{{ .theme.colors.cyan }}", is_bold: false }

# Users & Groups: default foreground without bold/yellow noise; root distinguished by underline.
users:
  user_you: { foreground: "Default", is_bold: false }
  user_root: { foreground: "Default", is_bold: false, is_underline: true }
  user_other: { foreground: "Default", is_bold: false }

  group_yours: { foreground: "Default", is_bold: false }
  group_root: { foreground: "Default", is_bold: false, is_underline: true }
  group_other: { foreground: "Default", is_bold: false }
