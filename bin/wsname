#!/bin/bash
#
# Print the current xmonad workspace name; -p prints its prefix and -s
# its suffix. Kept for old callers: see ws name.
#

# TODO: this is here for backwards compatible, remove later. Callers
# left: the w.* launchers and nautilus in xmonad/bin-xmonad, emacs
# init.el, wsenv-* and cdd in config-base/bash/functions, and scripts
# in the private and divio repositories.

hash ws 2>/dev/null || exit 1
exec ws name "$@" 2>/dev/null
