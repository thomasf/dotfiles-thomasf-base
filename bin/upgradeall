#!/bin/bash
#
#

# colors
reset="$(tput sgr0 2>/dev/null||echo -n)"
red="$(tput setaf 1 2>/dev/null||echo -n)"
green="$(tput setaf 2  2>/dev/null||echo -n)"
yellow="$(tput setaf 3  2>/dev/null||echo -n)"
magenta="$(tput setaf 5  2>/dev/null||echo -n)"

set -e
# set -x
set -exo pipefail

ts() {
  echo "${reset}[$(date +%T)] ${@}"
}

# runCmd runs a command in a new terminal window using term-run if there is a
# display and term-run is available, otherwise in a subshell.
runCmd() {
  if [ -n "$DISPLAY$WAYLAND_DISPLAY" ] && hash term-run 2>/dev/null; then
    term-run -n upgradeall -m hold -- "$@" &
  else
    (
      set +e
      "$@"
    )
  fi
}

upgrader-apt() {
  sudo apt update
  sudo apt dist-upgrade
}


# upgrader-go installs variout things using go get.
upgrader-go() {
  local out
  echo UPDATING go-tools
  GOPATH=${HOME}
  export GOPATH;
  for l in  \
      github.com/99designs/aws-vault/v7 \
      github.com/boyter/scc \
      github.com/charmbracelet/glow/v2 \
      github.com/cli/cli/v2/cmd/gh \
      github.com/cuonglm/gocmt \
      github.com/direnv/direnv \
      github.com/go-critic/go-critic/cmd/gocritic \
      github.com/go-delve/delve/cmd/dlv \
      github.com/golangci/golangci-lint/v2/cmd/golangci-lint \
      github.com/google/gops \
      github.com/google/ko \
      github.com/gopasspw/gopass \
      github.com/homeport/dyff/cmd/dyff \
      github.com/junegunn/fzf \
      github.com/magefile/mage \
      github.com/profclems/glab/cmd/glab \
      github.com/shurcooL/markdownfmt \
      github.com/smartystreets/goconvey \
      github.com/some-programs/tgo \
      github.com/tsenart/vegeta \
      github.com/x-motemen/ghq \
      golang.org/x/perf/cmd/benchstat \
      golang.org/x/pkgsite/cmd/pkgsite \
      golang.org/x/tools/cmd/goimports \
      golang.org/x/tools/cmd/stringer \
      golang.org/x/tools/gopls \
      golang.org/x/vuln/cmd/govulncheck \
      honnef.co/go/tools/cmd/staticcheck \
      mvdan.cc/gofumpt \
    ; do
    ts "${green}${l}${reset}"
    (
      go install "${l}@latest"
    ) || echo -e "\n${red}FAILED ${l}\n${yellow}${out}${reset}\n"
  done
}

upgrader-pip() {
  py-cmd-env upgrade
}

upgrader-npm() {
  echo "no npm packages"
}

upgrader-cargo() {
  cargo install \
        --locked \
        bat \
        csvlens \
        diffr \
        du-dust \
        eza \
        fblog \
        fd-find \
        gitu \
        gitui \
        hexyl \
        hyperfine \
        jj-cli \
        just \
        mise \
        pastel \
        ripgrep \
        stgit \
        tokei \
        usage-cli \
        vcprompt \
        watchexec-cli \
    ;
}

upgrader-chrome() {
  (curl https://dl.google.com/linux/direct/google-chrome-stable_current_$(dpkg --print-architecture).deb> /tmp/chrome.deb ) && sudo dpkg -i /tmp/chrome.deb && rm /tmp/chrome.deb
  }

dp() {
  for i in ${@}; do
    ts "${green}${i}${reset}"
    docker pull ${i}
  done
}

upgrader-docker() {
  dp golang:1.{22,23,24}{,-alpine}
  dp python:{3.10,3.11,3.12,3.13}{,-alpine}
  dp ubuntu:{20.04,22.04,24.04}
  dp redis:{6,7}
  dp postgres:{13,14,15,16,17}
  dp plugins/{docker,slack,git,s3,drone-git}
  dp thomasf/{twine,drone-devpi}
  dp minio/minio
  # dp drone/drone:0.7
}

cmd=${1}
case $cmd in
  apt|go|npm|pip|docker|cargo|chrome)
    upgrader-${cmd}
    ;;
  all)
    # runCmd sudo nala upgrade
    runCmd "$0" apt
    runCmd dotfiles pull
    runCmd "$0" go &
    runCmd "$0" pip &
    runCmd "$0" cargo &
    ;;
  *)
    echo "$0 all apt cargo go npm pip"
    ;;
esac

