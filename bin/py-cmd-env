#!/usr/bin/env bash

set -e

bn=$(basename "$0")
bin_dir="${UV_TOOL_BIN_DIR:-$HOME/.local/bin}"
target_bin="$bin_dir/$bn"

case $bn in
  py-cmd-env)
    subcommand=${1:-}
    case $subcommand in
      u|upgrade)
        exec uv tool upgrade --all
        ;;
      ls|list-envs|list)
        exec uv tool list
        ;;
      upgrade-env)
        shift
        exec uv tool upgrade "$@"
        ;;
      *)
        echo "Usage: py-cmd-env [upgrade|list|upgrade-env <tool>]" >&2
        exit 1
        ;;
    esac
    ;;

  ansible|ansible-*)
    pkg="ansible"
    ;;
  platformio|pio)
    pkg="platformio"
    ;;
  git-goggles)
    pkg="git-goggles"
    extra_args=(--with termcolor)
    ;;
  yt-dlp)
    pkg="yt-dlp"
    extra_args=(--with yt-dlp-ejs)
    ;;
  devpi*)
    pkg="devpi-client"
    extra_args=(--with-executables-from devpi-server)
    ;;
  sam)
    pkg="aws-sam-cli"
    ;;
  *)
    pkg="$bn"
    ;;
esac

if [ ! -x "$target_bin" ]; then
  echo "Provisioning $pkg via uv tool..." >&2
  uv tool install "$pkg" "${extra_args[@]}"
fi

if [ ! -x "$target_bin" ]; then
  echo "Error: $target_bin was not created by installing $pkg" >&2
  exit 1
fi

exec "$target_bin" "$@"
